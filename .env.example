# =============================================================================
# ClinCase — example environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Three deployment modes:
#   1. LOCAL DEV  (default values below) — postgres + openrouter, mock TriZetto + mock Q
#   2. BEDROCK    — flip LLM_PROVIDER=bedrock, set Bedrock + Guardrail vars
#   3. PRODUCTION (post-pilot) — set REDIS_URL, TRIZETTO_GATEWAY_URL, AMAZON_Q_*
# =============================================================================

# --- LLM provider ----------------------------------------------------------
LLM_PROVIDER=openrouter                      # local dev default; flip to "bedrock" for AWS deploys
# Only needed if LLM_PROVIDER=anthropic. Keep comments on their own line:
# python-dotenv reads "KEY=   # text" as the value "# text".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Only needed if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- AWS / Bedrock (production) -------------------------------------------
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-6-20251022-v1:0
BEDROCK_HAIKU_MODEL_ID=apac.anthropic.claude-haiku-4-5-20251001-v1:0
# Per-tenant; provisioned during onboarding (ops/multi-tenant/ONBOARDING.md)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# Optional — leave empty if using Q Business
BEDROCK_KB_ID=

# --- GenAI Gateway (in-process governance) --------------------------------
GENAI_GATEWAY_ENABLED=true                   # leave true unless debugging the underlying client

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://clincase:clincase@localhost:5432/clincase
# Pool sizing (per-pod). Defaults are 4/8 — see ops/k8s/config.yaml.
# DATABASE_POOL_MIN=4
# DATABASE_POOL_MAX=8

# --- Redis (multi-replica SSE pub/sub) ------------------------------------
# Empty = in-process pub/sub (single-replica dev). Set on prod with > 1 API replica.
REDIS_URL=

# --- TriZetto AI Gateway (Aug 2025 launch; MCP-native) -------------------
# Empty = in-process mock receiver at /api/v1/integrations/trizetto/_mock/inbox.
# Set both on prod to flip to live Gateway calls.
TRIZETTO_GATEWAY_URL=
TRIZETTO_GATEWAY_TOKEN=

# --- Amazon Q Business (alternative to Bedrock KB) ------------------------
# Empty = Bedrock KB / curated corpus. Set USE_AMAZON_Q=true + the IDs to flip.
USE_AMAZON_Q=false
AMAZON_Q_APPLICATION_ID=
AMAZON_Q_INDEX_ID=
AMAZON_Q_REGION=us-east-1

# --- Embeddings (pgvector dev path; production uses Bedrock Titan) -------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Environment + safety enforcement -------------------------------------
# When set to "staging" or "production", the Settings model_validator
# fails-fast if any secret below is the dev default. Stays "dev" in
# local + demo; flipped to "production" in real deploys.
ENVIRONMENT=dev

# --- Auth (JWT) -----------------------------------------------------------
# Dev default is fine for local; MUST rotate via AWS Secrets Manager in
# prod (the model_validator in app/config.py rejects boot otherwise).
JWT_SECRET=clincase-dev-secret-change-in-prod-via-env-CmDbYVQrV3
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080                     # 7 days for demo convenience

# --- Demo / seed users ----------------------------------------------------
# Bootstraps three demo accounts (admin/reviewer/coordinator) on first
# boot. MUST be overridden in staging/production (validator enforces it).
DEMO_USER_PASSWORD=clincase2026

# --- Flags ----------------------------------------------------------------
USE_BEDROCK_KB=false
SEED_ON_BOOT=false

# --- MCP server -----------------------------------------------------------
# /mcp always requires a normal ClinCase bearer JWT (tenant identity); the old shared MCP_AUTH_TOKEN is ignored.

# --- Platform administration ----------------------------------------------
# `admin` is an ORGANISATION role. Cross-tenant routes (/admin/tenants, global finops, prompt registry, ...)
# need the caller's user id (server-generated, not an e-mail) here. Empty = nobody (dev also accepts user_demoadmin).
PLATFORM_ADMIN_USER_IDS=
# Set explicitly in every deployment: dev | staging | production (guards only engage outside dev).
ENVIRONMENT=dev

# --- HITL gate ------------------------------------------------------------
# 0.0 in dev/demo so every case runs the full DAG. 0.75 in prod (CA SB 1120 conservative).
HITL_CONFIDENCE_THRESHOLD=0.0

# --- OncoTwin (digital twin) ------------------------------------------------
# OncoTwin needs no database and no LLM key: the twin, models and explanations are deterministic.
# 1 = let the Explanation agent ask the configured LLM_PROVIDER for a plain-language synthesis.
# LLM output is shown only if it passes every safety gate (schema, evidence-traceable numbers,
# freshness, uncertainty, safety language, model integrity); otherwise the deterministic text is used.
ONCOTWIN_LLM_EXPLANATIONS=0

# Safe defaults: DB outages fail closed. Enable only for a local DB-less demo.
AUTH_DBLESS_DEMO_ENABLED=false
# Cloud OCR transmits unredacted document pixels to the configured provider.
# Keep false unless provider handling is approved; local OCR/review remains available.
CLOUD_DOCUMENT_PROCESSING_ENABLED=false
