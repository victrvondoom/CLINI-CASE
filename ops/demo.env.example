# Demo settings that make the headline features fire. Copy to backend/.env and fill the secrets.
ENVIRONMENT=dev
DEMO_USER_PASSWORD=change-me-local-demo
JWT_SECRET=change-me-32+chars-random
LLM_PROVIDER=openrouter            # or bedrock once account/region/model access is verified
OPENROUTER_API_KEY=                # required for live runs
VERIFIER_ENABLED=true              # independent verifier after the Decision Composer
HITL_CONFIDENCE_THRESHOLD=0.7      # below this, the case pauses for a human
PLATFORM_ADMIN_USER_IDS=           # needed to upload/delete policies (platform operators only)
